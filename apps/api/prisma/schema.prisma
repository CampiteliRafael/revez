generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestCategory {
  IT
  INFRASTRUCTURE
  ADMINISTRATIVE
  PURCHASES
  HR
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  WAITING
  COMPLETED
}

model User {
  id               String    @id
  email            String?   @unique
  displayName      String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  createdRequests  Request[] @relation("RequestCreator")
  assignedRequests Request[] @relation("RequestAssignee")
  comments         Comment[]
  requestEvents    RequestEvent[] @relation("RequestEventActor")
}

model Team {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  requests  Request[]
}

model Request {
  id          String          @id @default(cuid())
  title       String
  description String
  category    RequestCategory
  priority    RequestPriority
  dueDate     DateTime        @db.Timestamptz(3)
  status      RequestStatus   @default(NEW)
  createdById String
  assigneeId  String
  teamId      String
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  creator  User @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee User @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  team     Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  comments     Comment[]
  requestEvents RequestEvent[]

  @@index([status, createdAt])
  @@index([category])
  @@index([assigneeId, status])
  @@index([teamId, status])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  requestId String
  authorId  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model RequestEvent {
  id        String   @id @default(cuid())
  action    String
  payload   Json?
  requestId String
  actorId   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User?   @relation("RequestEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}
